@{
    var project = (ProjectDto)ViewData["Project"]!;
    ViewData["Title"] = project.Name;
    ViewData["Page"] = "workspace";
}
@section TopActions {
    <button class="quiet-button" id="field-manager-button" title="Status und eigene Felder verwalten"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg><span>Eigene Felder</span></button>
}
@section Scripts {
    <script type="module" src="~/js/app.js" asp-append-version="true"></script>
}
<main data-project-id="@project.Id">
    <section class="page-heading">
        <div><div class="eyebrow">PROJEKT</div><h1>@project.Name</h1><p>Aufgaben &amp; Dokumente: Plane deine Arbeit und halte das zugehörige Wissen an einem Ort.</p></div>
        <div class="page-meta"><span id="task-count">0 Aufgaben</span></div>
    </section>
    <section class="work-area" aria-label="Aufgabenansichten">
        <div class="tabs-bar"><div id="view-tabs" class="view-tabs" role="tablist" aria-label="Darstellung"></div><div class="workspace-search"><label for="workspace-search">⌕</label><input id="workspace-search" type="search" aria-label="Projekt durchsuchen" placeholder="Einträge durchsuchen …" /></div></div>
        <div class="config-bar">
            <span class="config-bar-label">KONFIGURATIONEN</span>
            <div id="config-tabs" class="config-tabs" role="tablist" aria-label="Gespeicherte Konfigurationen"></div>
            <div class="config-create-actions" role="group" aria-label="Eintrag erstellen">
                <button class="secondary-button" id="new-folder-button">＋ Ordner</button>
                <button class="primary-button" id="new-task-button"><span>＋</span> Aufgabe</button>
                <button class="secondary-button" id="new-document-button">＋ Dokument</button>
            </div>
            <button id="add-view-button" class="add-view-button" title="Neue Konfiguration" aria-label="Neue Konfiguration"><span class="add-view-icon">＋</span><span class="add-view-label">Neue Konfiguration</span></button>
        </div>
        <div class="toolbar">
            <div class="toolbar-left"><span id="view-icon" class="view-icon"></span><div><div id="view-title" class="view-title"></div><div id="view-description" class="view-description"></div></div></div>
            <div class="toolbar-actions"><span id="filter-summary" class="filter-summary"></span><button id="edit-view-button" class="quiet-button">⚙ <span>Konfiguration bearbeiten</span></button></div>
        </div>
        <div id="view-content" class="view-content" aria-live="polite"><div class="loading">Ansicht wird geladen …</div></div>
    </section>
</main>

<div id="drawer-backdrop" class="drawer-backdrop" hidden></div>
<aside id="task-drawer" class="task-drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-caption" aria-hidden="true" hidden>
    <div class="drawer-header"><div class="drawer-heading"><button type="button" id="task-display-toggle" class="icon-button task-display-toggle" title="Als Popup anzeigen" aria-label="Als Popup anzeigen"></button><span id="drawer-caption">AUFGABE</span></div><button id="close-task-button" class="icon-button" aria-label="Schließen">✕</button></div>
    <form id="task-form" class="drawer-form">
        <input type="hidden" id="task-id" />
        <input type="hidden" id="item-kind" />
        <div class="drawer-scroll">
            <label class="form-label" for="task-title">Titel</label>
            <textarea id="task-title" class="title-input" rows="2" maxlength="300" required placeholder="Was steht an?"></textarea>
            <p id="item-prefill-note" class="prefill-note" hidden></p>
            <div class="field-grid">
                <label id="item-status-field"><span>Status</span><select id="task-status"></select></label>
                <label><span>Übergeordneter Eintrag</span><select id="task-parent"><option value="">Keine</option></select></label>
                <label id="item-start-field"><span>Startdatum</span><input id="task-start" type="date" /></label>
                <label id="item-due-field"><span>Fällig am</span><input id="task-due" type="date" /></label>
            </div>
            <span class="form-label" id="item-content-label">Beschreibung</span>
            <div id="task-description" class="description-editor"></div>
            <p id="task-description-error" class="form-error description-error" role="alert"></p>
            <section id="item-custom-fields-section"><div class="section-heading"><h3>Benutzerdefinierte Felder</h3><button type="button" id="drawer-add-field" class="text-button">＋ Feld erstellen</button></div><div id="task-custom-fields" class="custom-fields"></div></section>
            <div id="task-children-section" class="children-section" hidden><div class="section-heading"><h3>Untergeordnete Einträge</h3><div><button type="button" id="add-child-folder-button" class="text-button" hidden>＋ Ordner</button><button type="button" id="add-child-button" class="text-button">＋ Aufgabe</button><button type="button" id="add-child-document-button" class="text-button">＋ Dokument</button></div></div><div id="task-children"></div></div>        </div>
        <div class="drawer-footer"><button type="button" id="delete-task-button" class="danger-button" title="In den Papierkorb verschieben, samt untergeordneten Einträgen" hidden>Löschen</button><div class="footer-spacer"></div><span id="task-form-error" class="form-error"></span><button type="submit" class="primary-button">Speichern</button></div>
    </form>
</aside>

<dialog id="view-dialog" class="modal" aria-labelledby="view-dialog-heading">
    <form id="view-form">
        <div class="modal-header"><div><span class="eyebrow">ANSICHT</span><h2 id="view-dialog-heading">Konfiguration bearbeiten</h2></div><button type="button" class="icon-button dialog-close" data-dialog="view-dialog" aria-label="Schließen">✕</button></div>
        <div class="modal-body">
            <label class="form-label" for="config-name">Name</label><input id="config-name" maxlength="100" required placeholder="Zum Beispiel: Wichtige Aufgaben" />
            <label class="form-label" for="config-kind">Darstellung</label><select id="config-kind"><option value="Tree">Baum / Tabelle</option><option value="Kanban">Kanban</option><option value="Calendar">Kalender</option><option value="Timeline">Zeitachse</option></select>
            <div id="grouping-settings"><label class="form-label" for="config-group-by">Gruppieren nach</label><select id="config-group-by"><option value="">Keine Gruppierung</option></select><p class="helper-text">Einträge mit gleichem Feldwert erscheinen in einer Gruppe.</p></div>
            <div id="sort-settings"><label class="form-label" for="config-sort-by">Sortieren nach</label><div class="sort-controls"><select id="config-sort-by"><option value="">Manuelle Reihenfolge</option></select><select id="config-sort-direction" aria-label="Sortierrichtung"><option value="asc">Aufsteigend</option><option value="desc">Absteigend</option></select></div><p class="helper-text">Leere Werte stehen immer am Ende. Im Baum wird innerhalb jeder Ebene sortiert.</p></div>
            <label class="checkbox-setting"><input type="checkbox" id="config-hide-completed" /><span>Abgeschlossene Aufgaben ausblenden</span></label>
            <div class="section-heading"><h3>Angezeigte Felder</h3></div><p class="helper-text">Wähle die Informationen, die in dieser Ansicht sichtbar sind.</p><div id="visible-fields" class="checkbox-grid"></div>
            <div class="section-heading"><h3>Filter</h3><button type="button" id="add-filter-button" class="text-button">＋ Filter hinzufügen</button></div><p class="helper-text">Alle Filter müssen zutreffen.</p><div id="filter-rows" class="filter-rows"></div>
        </div>
        <div class="modal-footer"><button type="button" id="delete-view-button" class="danger-button" hidden>Konfiguration löschen</button><div class="footer-spacer"></div><span id="view-form-error" class="form-error"></span><button type="button" class="secondary-button dialog-close" data-dialog="view-dialog">Abbrechen</button><button type="submit" class="primary-button">Speichern</button></div>
    </form>
</dialog>

<dialog id="field-dialog" class="modal narrow-modal" aria-labelledby="field-dialog-heading">
    <div class="modal-header"><div><span class="eyebrow">PROJEKT</span><h2 id="field-dialog-heading">Eigene Felder</h2></div><button type="button" class="icon-button dialog-close" data-dialog="field-dialog" aria-label="Schließen">✕</button></div>
    <div class="modal-body"><div id="field-list" class="field-list"></div><div class="section-heading"><h3>Neues Feld</h3></div><form id="field-form"><label class="form-label" for="field-name">Name</label><input id="field-name" maxlength="100" required placeholder="Zum Beispiel: Kunde" /><label class="form-label" for="field-type">Typ</label><select id="field-type"><option value="Text">Text</option><option value="Select">Auswahl</option><option value="Number">Zahl</option><option value="Date">Datum</option><option value="Boolean">Ja / Nein</option></select><div id="field-options-wrap" hidden><span class="form-label">Optionen</span><div id="field-options"></div></div><div class="inline-submit"><span id="field-form-error" class="form-error"></span><button type="submit" class="primary-button">Feld erstellen</button></div></form></div>
</dialog>

<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
